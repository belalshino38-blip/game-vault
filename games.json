# Keep only new, unique games and Steam IDs.
existing_ids = {g["steamId"] for g in games if g.get("steamId") is not None}
existing_titles = {g["title"].strip().lower() for g in games}
selected = []
used_ids = set(existing_ids)

for title, genre, year, steam_id, multiplayer in additions:
    if steam_id in used_ids or title.strip().lower() in existing_titles:
        continue
    selected.append({
        "id": len(games) + len(selected) + 1,
        "title": title,
        "genre": genre,
        "year": year,
        "steamId": steam_id,
        "multiplayer": multiplayer
    })
    used_ids.add(steam_id)
    existing_titles.add(title.strip().lower())

# The request was for exactly 100 additions.
selected = selected[:100]

final_games = games + selected

# Re-number IDs cleanly.
for i, game in enumerate(final_games, start=1):
    game["id"] = i

with open(output_path, "w", encoding="utf-8") as f:
    json.dump(final_games, f, ensure_ascii=False, indent=2)

