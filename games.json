fixes = {
    "Dragon Age Inquisition": 1222690,
    "Guild Wars 2": 1284210,
    "Hades 2": 1145350,
    "Uncharted 4": 1659420,
}

for game in games:
    if game["title"] in fixes:
        game["steamId"] = fixes[game["title"]]

